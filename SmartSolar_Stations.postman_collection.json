{
	"info": {
		"_postman_id": "aa12345b-c678-9012-d345-e67890f12345",
		"name": "SmartSolar - Stations Setup",
		"description": "Collection to log in as admin and create 10 Sri Lanka stations.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.environment.set(\"jwt_token\", jsonData.token);",
							"    console.log(\"JWT Token saved to environment.\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"usernameOrNic\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
				},
				"url": {
					"raw": "http://localhost:5088/api/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5088",
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			}
		},
		{
